# Lichess OAuth. Lichess has NO app registration: the client_id is just any stable
# string (e.g. "middlegame-trainer"). Auth uses PKCE, so there is no client secret.
# Without a client_id, auth endpoints return a clear "not_configured" error but the
# server still runs.
LICHESS_CLIENT_ID=middlegame-trainer
# Where Lichess sends the user back after authorizing. No registration needed;
# this just has to match the origin users reach the app on.
LICHESS_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Address the server binds to.
BIND=0.0.0.0:8080
# SQLite connection string. The parent directory is created automatically.
DATABASE_URL=sqlite://data/app.db
# Directory of static frontend assets served at non-/api routes (SPA fallback to index.html).
# Leave empty in dev when using the Vite dev server.
STATIC_DIR=../frontend/dist
